    <light name="Warehouse_CeilingLight_003" type="point">
      <pose frame="">0 0 9 0 0 0</pose>
      <diffuse>0.5 0.5 0.5 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>80</range>
        <constant>0.3</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <cast_shadows>1</cast_shadows>
      <direction>0.1 0.1 -1</direction>
    </light>

    

        <!-- ===================================================== -->
    <!-- BANDA TRANSPORTADORA                                  -->
    <!-- Dirección de movimiento: +Y -> -Y                    -->
    <!-- ===================================================== -->

    <model name="conveyor_belt">

      <!-- Base de la banda (top en z = 0.61) -->
      <link name="belt_base">
        <pose>-1.1 0.75 0.485 0 0 0</pose>
        <inertial>
          <mass>20</mass>
          <inertia>
            <ixx>13.3</ixx><iyy>1.7</iyy><izz>13.5</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <box><size>1.0 8.9 0.25</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>1.0 8.9 0.25</size></box>
          </geometry>
          <material>
            <ambient>0.08 0.08 0.08 1</ambient>
            <diffuse>0.12 0.12 0.12 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>

      <!-- Superficie de la banda (z 0.61 a 0.65, sin traslape con la base) -->
      <link name="belt_surface">
        <pose>-1.1 0.75 0.63 0 0 0</pose>
        <inertial>
          <mass>5</mass>
          <inertia>
            <ixx>33.0</ixx><iyy>0.42</iyy><izz>33.4</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <box><size>1.0 8.9 0.04</size></box>
          </geometry>
          <surface>
            <friction>
              <ode><mu>1.0</mu><mu2>1.0</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>1.0 8.9 0.04</size></box>
          </geometry>
          <material>
            <ambient>0.02 0.02 0.02 1</ambient>
            <diffuse>0.03 0.03 0.03 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>

      <!-- Rodillo superior: solo visual (sin colisión).
          Eje a lo largo de X (roll en Y), radio reducido para no sobresalir. -->
      <link name="roller_top">
        <pose>-1.1 5.1 0.5 0 1.5708 0</pose>
        <inertial>
          <mass>1</mass>
          <inertia>
            <ixx>0.02</ixx><iyy>0.02</iyy><izz>0.0072</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <visual name="visual">
          <geometry>
            <cylinder><radius>0.12</radius><length>1.0</length></cylinder>
          </geometry>
        </visual>
      </link>

      <!-- Rodillo inferior: solo visual -->
      <link name="roller_bottom">
        <pose>-1.1 -3.6 0.5 0 1.5708 0</pose>
        <inertial>
          <mass>1</mass>
          <inertia>
            <ixx>0.02</ixx><iyy>0.02</iyy><izz>0.0072</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <visual name="visual">
          <geometry>
            <cylinder><radius>0.12</radius><length>1.0</length></cylinder>
          </geometry>
        </visual>
      </link>

      <!-- Soportes laterales (solo visual) -->
      <link name="left_support">
        <pose>-1.65 0.75 0.285 0 0 0</pose>
        <visual name="visual">
          <geometry>
            <box><size>0.12 8.9 0.35</size></box>
          </geometry>
        </visual>
      </link>

      <link name="right_support">
        <pose>-0.55 0.75 0.285 0 0 0</pose>
        <visual name="visual">
          <geometry>
            <box><size>0.12 8.9 0.35</size></box>
          </geometry>
        </visual>
      </link>

      <!-- Joints fijos: todo queda sujeto al mundo -->
      <joint name="base_world" type="fixed">
        <parent>world</parent>
        <child>belt_base</child>
      </joint>
      <joint name="surface_base" type="fixed">
        <parent>belt_base</parent>
        <child>belt_surface</child>
      </joint>
      <joint name="roller_top_base" type="fixed">
        <parent>belt_base</parent>
        <child>roller_top</child>
      </joint>
      <joint name="roller_bottom_base" type="fixed">
        <parent>belt_base</parent>
        <child>roller_bottom</child>
      </joint>
      <joint name="left_base" type="fixed">
        <parent>belt_base</parent>
        <child>left_support</child>
      </joint>
      <joint name="right_base" type="fixed">
        <parent>belt_base</parent>
        <child>right_support</child>
      </joint>

      <!-- Controlador de movimiento de la banda -->
      <plugin
          filename="libignition-gazebo-track-controller-system.so"
          name="ignition::gazebo::systems::TrackController">
        <link>belt_surface</link>
        <track_orientation>0 0 -1.5708</track_orientation>
        <velocity_topic>/conveyor_belt/cmd_vel</velocity_topic>
        <debug>1</debug>
      </plugin>

    </model>

