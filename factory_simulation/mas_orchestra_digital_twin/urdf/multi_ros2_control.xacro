    <joint name="r2/joint_NAUO5">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="r2/joint_NAUO6">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="r2/joint_NAUO7">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

		<!-- R3 -->
		<joint name="r3/joint_NAUO2">
			<command_interface name="position"/>
			<state_interface name="position"/>
			<state_interface name="velocity"/>
		</joint>

		<joint name="r3/joint_NAUO4">
			<command_interface name="position"/>
			<state_interface name="position"/>
			<state_interface name="velocity"/>
