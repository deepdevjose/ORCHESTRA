<?xml version="1.0"?>

<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <ros2_control name="IgnitionSystem" type="system">

    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <!-- R1 -->
    <joint name="r1/joint_NAUO2">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="r1/joint_NAUO4">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="r1/joint_NAUO3">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="r1/joint_NAUO5">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="r1/joint_NAUO6">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="r1/joint_NAUO7">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <!-- R2 -->
    <joint name="r2/joint_NAUO2">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
